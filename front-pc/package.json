{
  "name": "dajin-front-pc",
  "description": "打金店收银台",
  "version": "1.0.1",
  "author": "打金店系统",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron electron/main.cjs\"",
    "build": "vite build && node scripts/verify-build.cjs",
    "dist": "pnpm run build && electron-builder",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "latest",
    "concurrently": "^9.1.2",
    "element-plus": "^2.9.4",
    "lucide-vue-next": "^0.468.0",
    "sql.js": "^1.13.0",
    "vite": "^6.1.0",
    "vue": "^3.5.13",
    "wait-on": "^8.0.3"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "vitest": "^3.0.5"
  },
  "build": {
    "appId": "com.dajin.cashier",
    "productName": "打金店收银台",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "electronDownload": { "mirror": "https://npmmirror.com/mirrors/electron/" }
  }
}
